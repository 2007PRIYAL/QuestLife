{
  "name": "questlife-project",
  "version": "1.0.0",
  "private": true,
  "description": "QuestLife - Fantasy RPG Gamified Life Manager",
  "scripts": {
    "dev": "node dev.js",
    "start": "node dev.js",
    "dev:server": "npm run dev --prefix server",
